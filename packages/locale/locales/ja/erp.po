msgstr "テンプレート"

msgid "Temporary disposal-clearing account debited for an asset's net book value on shipment and credited for its net book value on invoicing, netting to zero over the sale cycle."
msgstr "一時的な処分・清算勘定科目で、資産の未償却残高は出荷時に借方記入され、請求時に貸方記入され、販売サイクル全体でゼロに相殺されます。"

msgid "Terms and Privacy"
msgstr "利用規約とプライバシー"

msgid "Terms of Service"
msgstr "利用規約"

msgid "Test"
msgstr "テスト"

msgid "Test run"
msgstr "テストラン"

msgid "Test run — results are not saved to the Runs page"
msgstr "テストラン —結果は「ラン」ページに保存されません"

msgid "Test runs are not saved. Close this panel and the result is gone."
msgstr "テストランは保存されません。このパネルを閉じると結果は消えます。"

msgid "Test Value"
msgstr "テスト値"

