msgid "You haven't created any contacts yet."
msgstr "Henüz hiç ilgili kişi oluşturmadınız."

msgid "You lead"
msgstr "Siz yönetiyorsunuz"

msgid "You name a project owner with decision authority"
msgstr "Bir proje sahibini karar verme yetkisiyle atarsınız"

msgid "You received this item"
msgstr "Bu ürünü siz aldınız"

msgid "You received this lot"
msgstr "Bu partiyi aldınız"

msgid "You're live on Carbon"
msgstr "Carbon'da canlısınız"

msgid "You're one step away from your workspace."
msgstr "Çalışma alanınıza bir adım uzaktasınız."

msgid "You're setting Carbon up yourself, at your own pace"
msgstr "Carbon'ı kendiniz kendi hızınızda ayarlıyorsunuz"

msgid "You've been clocked in for {hoursElapsed} hours. Did you forget to clock out?"
msgstr "{hoursElapsed} saattir işte idiniz. İş bitişini unuttunuz mu?"

msgid "Your account stays safe even if your login is stolen"
msgstr "Oturum açma bilgileriniz çalınsa bile hesabınız güvenli kalır"

msgid "Your books and how money flows."
msgstr "Muhasebe defterleriniz ve paranın akışı."

msgid "Your changes go into a new draft version released with this change notice."
msgstr "Değişiklikleriniz bu değişiklik bildirisi ile yayınlanan yeni taslak sürüme girer."

msgid "Your Console PIN"
msgstr "Konsol PIN'iniz"

msgid "Your customer list"
msgstr "Müşteri listeniz"

msgid "Your customer-facing price lists"
msgstr "Müşterilerinize sunduğunuz fiyat listeleri"

msgid "Your data is accessible and reasonably clean"
msgstr "Verileriniz erişilebilir ve makul ölçüde temizdir"

msgid "Your DNS provider may auto-append your domain to the record name — if so, enter only the part before it (e.g. _carbon-challenge plus any subdomain)."
msgstr "DNS sağlayıcınız kaydın adına etki alanınızı otomatik olarak ekleyebilir — eğer öyleyse, yalnızca önceki kısmı girin (ör. _carbon-challenge artı herhangi bir alt alan adı)."

msgid "Your Email"
