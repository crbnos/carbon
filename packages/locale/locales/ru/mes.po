msgid "Write a note…"
msgstr "Напишите примечание…"

msgid "Yes"
msgstr "Да"

msgid "You can still start this operation."
msgstr "Вы все еще можете начать эту операцию."

msgid "You can't work on this operation"
msgstr "Вы не можете работать над этой операцией"

msgid "You do not have permission to do this"
msgstr "У вас нет права доступа для выполнения этого"

msgid "You don't have permission to change this record, or it no longer exists."
msgstr "У вас нет права доступа для изменения этой записи, или она больше не существует."

msgid "You don't have the {processName} ability"
msgstr "У вас нет навыка «{processName}»"

msgid "You've been clocked in for {hoursElapsed} hours. Did you forget to clock out?"
msgstr "Вы находились на работе {hoursElapsed} часов. Вы забыли записать окончание работы?"

msgid "Your {processName} qualification expired on {expiredDate}."
msgstr "Ваша квалификация по «{processName}» истекла {expiredDate}."

msgid "Your account isn't part of a company yet. Complete onboarding in the Carbon ERP to continue."
msgstr "Ваша учетная запись еще не входит ни в одну Организацию. Завершите подготовку к работе в Carbon ERP, чтобы продолжить."

msgid "Your organization requires an authenticator app. Set it up in Carbon, then come back here."
msgstr "Ваша организация требует приложения аутентификатора. Настройте его в Carbon, а затем вернитесь сюда."

msgid "Your profile could not be loaded."
msgstr "Не удалось загрузить ваш профиль."

msgid "Your session was locked after inactivity."
msgstr "Ваш сеанс был заблокирован после неактивности."

msgid "Your signature"
msgstr "Ваша подпись"

