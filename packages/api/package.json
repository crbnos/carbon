{
  "name": "@carbon/api",
  "private": true,
  "version": "0.0.0",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./carbon.server": "./src/carbon.server.ts",
    "./schema": "./src/schema.ts",
    "./service-fn.server": "./src/service-fn.server.ts",
    "./service-tools.server": "./src/service-tools.server.ts",
    "./errors": "./src/errors.ts",
    "./permissions": "./src/permissions.ts",
    "./postings.server": "./src/postings.server.ts",
    "./postings": "./src/postings.ts",
    "./internal-call": "./src/internal-call.ts"
  },
  "scripts": {
    "clean": "rimraf .turbo node_modules dist",
