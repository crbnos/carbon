{
  "name": "@carbon/stripe",
  "dependencies": {
    "@carbon/auth": "workspace:*",
    "@carbon/database": "workspace:*",
    "@carbon/env": "workspace:*",
    "@carbon/files": "workspace:*",
    "@carbon/kv": "workspace:*",
    "@carbon/lib": "workspace:*",
    "@carbon/logger": "workspace:*",
    "@carbon/utils": "workspace:*",
    "@internationalized/date": "catalog:",
    "dotenv": "16.3.1",
    "stripe": "22.4.0",
    "zod": "catalog:"
  },
  "type": "module",
  "devDependencies": {
    "@carbon/config": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "@types/node": "20.19.39",
    "rimraf": "catalog:",
    "sst": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    "./stripe.server": "./src/stripe.server.ts",
    "./connect.server": "./src/connect.server.ts",
    "./connect.constants": "./src/connect.constants.ts",
    "./connect-invoice": "./src/connect-invoice.ts",
    "./send-sales-invoice.server": "./src/send-sales-invoice.server.ts"
