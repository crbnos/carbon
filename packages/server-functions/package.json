{
  "name": "@carbon/server-functions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./company-records": "./src/company-records.ts",
    "./shelf-life": "./src/shelf-life.ts",
    "./tracked-entity-attributes": "./src/tracked-entity-attributes.ts",
    "./server-fn-context": "./src/server-fn-context.ts",
    "./always-post-test-fixture": "./src/always-post-test-fixture.ts",
    "./local-database-test-fixture": "./src/local-database-test-fixture.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "clean": "rimraf .turbo node_modules",
    "lint": "biome lint --write ",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@carbon/api": "workspace:*",
    "@carbon/auth": "workspace:*",
    "@carbon/database": "workspace:*",
    "@carbon/env": "workspace:*",
    "@carbon/files": "workspace:*",
    "@carbon/logger": "workspace:*",
    "@carbon/utils": "workspace:*",
    "@internationalized/date": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "kysely": "catalog:",
    "nanoid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@carbon/config": "workspace:*",
    "@types/pg": "8.15.6",
    "pg": "8.20.0",
    "vitest": "catalog:"
  }
}
