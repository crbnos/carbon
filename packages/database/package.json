{
  "name": "@carbon/database",
  "devDependencies": {
    "@carbon/config": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "@types/node": "20.19.39",
    "@types/pg": "8.15.6",
    "@types/uuid": "8.3.4",
    "dotenv": "16.3.1",
    "npm-run-all": "catalog:",
    "rimraf": "catalog:",
    "supabase": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "uuid": "9.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./datetime": "./src/datetime.ts",
    "./fetch-all": "./src/fetch-all.ts",
    "./logging": "./src/logging.ts",
    "./methods": "./src/methods.ts",
    "./mrp-engine": "./src/mrp-engine.ts",
    "./supersession-pick": "./src/supersession-pick.ts",
    "./datasets": "./src/datasets/index.ts",
    "./event": "./src/event.ts",
    "./quality": "./src/quality.ts",
    "./ratelimit": "./src/ratelimit.ts",
    "./sampling": "./src/sampling.ts",
    "./sequence": "./src/sequence.ts",
    "./seed-workflows": "./src/datasets/tiers/workflow-definitions.ts",
    "./audit": "./src/audit.ts",
    "./audit.config": "./src/audit.config.ts",
    "./audit.types": "./src/audit.types.ts",
    "./swagger-docs-schema": "./src/swagger-docs-schema.ts",
    "./dataset-assets": "./src/datasets/assets.ts"
  },
  "private": true,
  "scripts": {
    "clean": "rimraf .turbo node_modules dist",
    "db:check:datasets": "tsx src/check-datasets.ts",
    "db:function:new": "supabase functions new",
    "db:init": "supabase init",
    "db:migrate:new": "supabase migration new",
    "db:seed": "tsx src/seed.ts",
    "db:seed:dev": "tsx src/seed-dev.ts",
    "deploy": "supabase link --project-ref $SUPABASE_PROJECT_ID && supabase db push",
    "lint": "biome lint --write ",
    "typecheck": "tsgo --noEmit"
  },
  "sideEffects": false,
  "version": "0.0.0",
  "dependencies": {
    "@internationalized/date": "catalog:",
    "@logtape/logtape": "catalog:",
    "@logtape/redaction": "catalog:",
    "@supabase/postgrest-js": "catalog:",
    "cookie": "catalog:",
    "dompurify": "catalog:",
    "kysely": "catalog:",
    "kysely-supabase": "0.2.1",
    "nanoid": "catalog:",
    "pg": "8.20.0",
    "react-pdf": "catalog:",
    "sst": "catalog:",
    "zod": "catalog:"
  }
}
