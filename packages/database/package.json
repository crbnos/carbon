{
  "name": "@carbon/database",
  "devDependencies": {
    "@carbon/config": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "@types/node": "20.19.39",
    "@types/pg": "8.15.6",
    "@types/uuid": "8.3.4",
    "dotenv": "16.3.1",
    "libpg-query": "18.1.5",
    "npm-run-all": "catalog:",
    "rimraf": "catalog:",
    "supabase": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "uuid": "9.0.0",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./configuration-rule": "./src/configuration-rule.ts",
    "./fetch-all": "./src/fetch-all.ts",
    "./job-quantities-engine": "./src/job-quantities-engine.ts",
    "./json": "./src/json.ts",
    "./price-trace": "./src/price-trace.ts",
    "./rows": "./src/rows.ts",
    "./methods": "./src/methods.ts",
    "./mrp-engine": "./src/mrp-engine.ts",
    "./supersession-pick": "./src/supersession-pick.ts",
    "./picked-consumption": "./src/picked-consumption.ts",
    "./posting": "./src/posting.ts",
    "./datasets": "./src/datasets/index.ts",
    "./event": "./src/event.ts",
    "./quality": "./src/quality.ts",
    "./ratelimit": "./src/ratelimit.ts",
    "./sampling": "./src/sampling.ts",
    "./sequence": "./src/sequence.ts",
    "./seed-data": "./src/seed-data.ts",
    "./seed-workflows": "./src/datasets/tiers/workflow-definitions.ts",
    "./audit.config": "./src/audit.config.ts",
    "./audit.types": "./src/audit.types.ts",
    "./swagger-docs-schema": "./src/swagger-docs-schema.ts",
    "./dataset-assets": "./src/datasets/assets.ts",
    "./dataset-rule-fields": "./src/datasets/rule-fields.ts",
    "./precision": "./src/precision.ts",
    "./accounting-currency": "./src/accounting-currency.ts",
    "./accounting-posting": "./src/accounting-posting.ts",
    "./sales-posting-amounts": "./src/sales-posting-amounts.ts",
    "./ledger": "./src/ledger.ts"
  },
  "private": true,
  "scripts": {
    "clean": "rimraf .turbo node_modules dist",
    "authz": "tsx src/authz/cli.ts",
    "db:check:datasets": "tsx src/check-datasets.ts",
    "db:function:new": "supabase functions new",
    "db:init": "supabase init",
    "db:migrate:new": "supabase migration new",
    "db:seed": "tsx src/seed.ts",
    "db:seed:dev": "tsx src/seed-dev.ts",
    "deploy": "supabase link --project-ref $SUPABASE_PROJECT_ID && supabase db push",
    "lint": "biome lint --write ",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit"
  },
  "sideEffects": false,
  "version": "0.0.0",
  "dependencies": {
    "@internationalized/date": "catalog:",
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "@supabase/postgrest-js": "catalog:",
    "cookie": "catalog:",
    "dompurify": "catalog:",
    "kysely": "catalog:",
    "kysely-supabase": "0.2.1",
    "nanoid": "catalog:",
    "pg": "8.20.0",
    "quickjs-emscripten-core": "0.32.0",
    "react-pdf": "catalog:",
    "sst": "catalog:",
    "sucrase": "3.35.1",
    "zod": "catalog:"
  }
}
