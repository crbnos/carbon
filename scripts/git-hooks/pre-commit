#!/bin/sh
set -e

pnpm exec lint-staged

# Extract for config, catalogs, or changed source files that contain messages.
# Inspect both versions so edits inside multiline messages and removals count.
needs_lingui() {
    git diff --cached --name-only | grep -qE '\.po$|^lingui\.config\.js$' && return 0
    message_markers='<(Trans|Plural|Select)([[:space:]>]|$)|(^|[^A-Za-z0-9_])(t|msg)[[:space:]]*[`(]|(^|[^A-Za-z0-9_])(plural|select|selectOrdinal)[[:space:]]*\(|@lingui/(core|react)/macro|/\*+[[:space:]]*i18n[[:space:]]*\*/'
    git diff --cached --name-only -- '*.ts' '*.tsx' '*.js' '*.jsx' | (
        while IFS= read -r file; do
            if {
                git show ":$file" 2>/dev/null
                git show "HEAD:$file" 2>/dev/null
            } | grep -qE "$message_markers"; then
                exit 0
            fi
        done
        exit 1
    )
}
if needs_lingui; then
    echo "Compiling translations..."
    # Not a blocker — a catalog that won't compile is worth knowing about, but it
    # is not a reason to refuse the commit. It DOES stop the staging below, so a
    # failed run can never commit half-written catalogs.
    if pnpm lingui:check; then
        # Strip `#:` origin refs before committing — they shift on any upstream
        # code edit and are the biggest PR-conflict source. They're kept in the
        # working dir during the translate flow (linguito needs them for LLM
        # context) and only stripped right before commit.
        pnpm lingui:clean

        # Add compiled locale files to the commit
        git add packages/locale/locales/**/*.po
    else
        echo "⚠ Translations did not compile — catalogs left unstaged for this commit."
    fi
fi

# Demo-dataset drift only shows up when the datasets actually run. This dry-runs
# all four (~3s) — each rolls back, so it writes nothing.
# Set CARBON_SKIP_DATASET_CHECK=1 to skip.
if [ -z "$CARBON_SKIP_DATASET_CHECK" ] && git diff --cached --name-only | grep -q '^packages/database/'; then
    echo "Checking demo datasets against the schema..."
    # --silent so pnpm's ELIFECYCLE trailer doesn't bury the script's own advice.
    if ! pnpm --silent db:check:datasets; then
        echo ""
        echo "Commit blocked by the demo-dataset check. The reason is printed above."
        echo "Skip it with: CARBON_SKIP_DATASET_CHECK=1 git commit ..."
        exit 1
    fi
fi

# A migration can make a backup a customer already holds unrestorable, without the
# backup changing at all. This compares the schema baseline on main with your live
# schema, then updates and stages the baseline. Set CARBON_SKIP_BACKUP_CHECK=1 to skip.
if [ -z "$CARBON_SKIP_BACKUP_CHECK" ] && git diff --cached --name-only | grep -q '^packages/database/supabase/migrations/'; then
    echo "Checking backup compatibility against the schema..."
    if ! pnpm --silent db:check:backups -- --stage; then
        echo ""
        echo "Commit blocked by the backup compatibility check. The reason is printed above."
        echo "Skip it with: CARBON_SKIP_BACKUP_CHECK=1 git commit ..."
        exit 1
    fi
fi
