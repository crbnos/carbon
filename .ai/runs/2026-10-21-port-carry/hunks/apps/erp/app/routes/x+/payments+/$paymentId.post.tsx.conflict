  const { paymentId } = params;
  if (!paymentId) {
    return { success: false, message: "Missing paymentId" };
  }
  try {
    const result = await serverFns
      .system({ db: getDatabaseClient(), companyId, userId })
      .invoke("post-payment", { type: "post", paymentId });
    if (result.error) {
      const message = result.error.message || "Failed to post payment";
      throw redirect(
        path.to.payment(paymentId),
        await flash(request, error(result.error, message))
      );
    }
  } catch (err) {
    throw redirect(
      path.to.payment(paymentId),
      await flash(request, error(err, "Failed to post payment"))
    );
  }

  // A contract deposit can receive a financing request: it is now Paid.
  try {
    await markFinancingRequestsPaid(getDatabaseClient(), {
      companyId,
      paymentId,
      userId
    });
  } catch (err) {
    logger.error("Failed to mark the financing request paid", {
      companyId,
      paymentId,
      error: err
    });
  }

  throw redirect(
    path.to.payment(paymentId),
    await flash(request, success("Payment posted"))
  );
