###############################################################################
# Carbon — production docker-compose env. Copy to `.env.production` and fill in.
#   docker compose -f docker-compose.prod.yml --env-file .env.production ...
#
# Self-host (default): fill the SELF-HOST section + generate the Supabase keys.
# Managed backends: skip the `data` profile, point SUPABASE_*/REDIS_URL/INNGEST_*
#   at your managed services instead.
###############################################################################

# ── Public hostnames (Caddy routes these; must resolve to this host) ──────────
ERP_HOST=erp.example.com
MES_HOST=mes.example.com
SUPABASE_HOST=api.example.com
ACME_EMAIL=ops@example.com

# Derived app URLs — keep in sync with the hosts above (https://).
ERP_URL=https://erp.example.com
MES_URL=https://mes.example.com
SUPABASE_URL=https://api.example.com

# Production marker (drives getAppUrl / getMESUrl in @carbon/env).
NODE_ENV=production
VERCEL_ENV=production
# Required by @carbon/env at module load (value unused off-Vercel).
VERCEL_URL=production

# ── Supabase keys — RUN: node scripts/gen-supabase-keys.mjs, paste all three ──
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Self-hosted data plane (the `data` profile) ──────────────────────────────
# Internal Postgres superuser password (also set on all Supabase service roles
# via deploy/prod/postgres/01-roles.sh). Postgres is NOT published to the host.
POSTGRES_PASSWORD=
# App DB connection. env_file does NOT expand ${...} — write the password inline,
# matching POSTGRES_PASSWORD above. Self-host postgres runs without TLS, so keep
# ?sslmode=disable. (Managed mode: point at your external DB, sslmode=require.)
SUPABASE_DB_URL=postgresql://postgres:CHANGEME@postgres:5432/postgres?sslmode=disable
# Redis. Self-host: the internal container below. Managed: your external URL.
REDIS_URL=redis://redis:6379

# ── Inngest (self-hosted) ────────────────────────────────────────────────────
# Server + apps must share these. SIGNING_KEY must be plain even-length hex
# (the inngest server rejects the signkey-… prefix): openssl rand -hex 32
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
INNGEST_BASE_URL=http://inngest:8288
INNGEST_DEV=0

# ── App session ──────────────────────────────────────────────────────────────
# Random 32+ char string: openssl rand -hex 32
SESSION_SECRET=

# ── Auth: SMTP (gotrue sends invites / magic links) ──────────────────────────
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=admin@example.com

# ── Auth: external OAuth providers (optional) ────────────────────────────────
# Flip the matching *_AUTH_ENABLED to true only when you set its creds below.
AUTH_PROVIDERS=email,google,azure
GOOGLE_AUTH_ENABLED=false
AZURE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_REDIRECT_URI=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_REDIRECT_URI=

# ── Product config (optional) ────────────────────────────────────────────────
CARBON_EDITION=community
CONTROLLED_ENVIRONMENT=false
DEFAULT_LANGUAGE=en
RATE_LIMIT=5

# ── Integrations ─────────────────────────────────────────────────────────────
# Email — REQUIRED for ERP: it constructs the Resend client at boot and crashes
# if this is empty. Use a real key, or any non-empty placeholder if you don't
# send email yet (e.g. re_placeholder).
RESEND_API_KEY=
RESEND_DOMAIN=
# Everything below is optional — leave blank to disable.
# Analytics / bot protection
POSTHOG_API_HOST=
POSTHOG_PROJECT_PUBLIC_KEY=
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Currency
EXCHANGE_RATES_API_KEY=
# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Slack
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Accounting / CAD / PM
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
