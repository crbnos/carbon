{
  "name": "carbon",
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@lingui/cli": "catalog:",
    "@react-router/dev": "catalog:",
    "@types/aws-lambda": "8.10.152",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "cli-table3": "^0.6.5",
    "csv-parse": "5.6.0",
    "execa": "^8.0.1",
    "linguito": "^0.5.2",
    "lint-staged": "16.4.0",
    "npm-run-all": "catalog:",
    "rimraf": "catalog:",
    "simple-git-hooks": "2.14.0",
    "supabase": "catalog:",
    "ts-morph": "28.0.0",
    "tsx": "catalog:",
    "turbo": "2.9.6",
    "typescript": "catalog:",
    "vite": "catalog:",
    "zod": "catalog:"
  },
  "lint-staged": {
    "(apps|packages|docs)/**/*.{js,ts,jsx,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.json": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "simple-git-hooks": {
    "preserveUnused": true,
    "pre-commit": "if [ -f scripts/git-hooks/pre-commit ]; then sh scripts/git-hooks/pre-commit; elif [ -f .husky/pre-commit ]; then sh .husky/pre-commit; fi",
    "post-merge": "if [ -f scripts/git-hooks/post-merge ]; then sh scripts/git-hooks/post-merge; elif [ -f .husky/post-merge ]; then sh .husky/post-merge; fi"
  },
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:docs": "turbo run build --filter=docs",
    "build:erp": "turbo run build --filter=erp",
    "build:mes": "turbo run build --filter=mes",
    "check:manifest": "tsx scripts/check-manifest.ts",
    "check:workflow-catalog": "tsx scripts/check-workflow-catalog.ts",
    "ci:deploy": "pnpm --filter ci ci:deploy",
    "ci:migrations": "pnpm --filter ci ci:migrations",
    "clean": "turbo run clean && rimraf ./node_modules && rimraf ./pnpm-lock.yaml",
    "db:check:backups": "pnpm --filter @carbon/jobs db:check:backups --",
    "db:check:datasets": "pnpm --filter @carbon/database db:check:datasets --",
    "db:function:new": "pnpm --filter @carbon/database db:function:new",
    "db:migrate": "crbn migrate",
    "db:migrate:new": "pnpm --filter @carbon/database db:migrate:new",
    "db:seed": "turbo run db:seed --no-cache",
    "db:seed:dev": "pnpm --filter @carbon/database db:seed:dev --",
    "db:types": "tsx scripts/generate-db-types.ts",
    "deploy": "turbo run deploy",
    "dev": "crbn up --no-portless",
    "dev:academy": "turbo run dev --filter=./apps/academy --filter=./packages/",
    "dev:packages": "turbo run dev --filter=./packages/*",
    "dev:starter": "turbo run dev --filter=./apps/starter --filter=./packages/",
    "format": "biome format --write",
    "generate:mcp": "tsx scripts/generate-mcp.ts",
    "sweep:tools": "pnpm --filter erp exec vitest run --config vitest.sweep.config.ts",
    "generate:swagger": "tsx scripts/generate-swagger-docs.ts && pnpm exec biome format ./packages/database/src/swagger-docs-schema.ts --write --files-max-size=20000000",
    "generate:types": "tsx scripts/generate-db-types.ts",
    "generate:workflow-catalog": "tsx scripts/generate-workflow-catalog.ts && pnpm exec biome check --write packages/ee/src/workflows/catalog/",
    "install-skills": "bash .ai/scripts/install-skills.sh",
    "license:headers": "pnpm --filter @carbon/checks license-headers --",
    "lingui:check": "pnpm run lingui:extract && pnpm run lingui:compile",
    "lingui:clean": "node ./scripts/strip-po-headers.mjs",
    "lingui:compile": "lingui compile --namespace es",
    "lingui:extract": "lingui extract --clean",
    "lint": "turbo run lint",
    "postinstall": "MCP=//#generate:mcp; [ -n \"$VERCEL\" ] && [ \"${INIT_CWD##*/}\" = mes ] && MCP=; turbo run @carbon/documents#build $MCP --output-logs=new-only",
    "prepare": "case \"$(git config core.hooksPath)\" in *.husky) git config --unset core.hooksPath; git config --worktree --unset core.hooksPath;; esac; simple-git-hooks; if [ -f .ai/scripts/install-skills.sh ]; then bash .ai/scripts/install-skills.sh; fi",
    "test": "turbo run test",
    "translate": "pnpm run lingui:extract && pnpm exec linguito translate --llm && pnpm lingui:clean",
    "typecheck": "turbo run typecheck --filter='*'",
    "typegen": "turbo run typegen"
  },
  "workspaces": [
    "apps/*",
    "ci",
    "docs",
    "contrib/building/examples/*",
    "packages/*"
  ],
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "@carbon/api": "workspace:*",
    "@opentelemetry/semantic-conventions": "1.40.0",
    "@react-router/remix-routes-option-adapter": "catalog:",
    "cookie": "catalog:",
    "dompurify": "catalog:",
    "fast-uri": "3.1.5",
    "fdir": "6.5.0",
    "nanoid": "catalog:",
    "react-pdf": "catalog:",
    "remix-flat-routes": "catalog:",
    "sst": "catalog:",
    "tsup": "catalog:"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.1"
  },
  "crbn": {
    "copy": [
      ".env"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@swc/core",
      "@tailwindcss/oxide",
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp",
      "supabase"
    ],
    "patchedDependencies": {
      "@react-router/dev@7.18.4": "patches/@react-router__dev@7.18.4.patch",
      "@vercel/react-router@1.2.6": "patches/@vercel__react-router@1.2.6.patch",
      "supabase@2.89.0": "patches/supabase@2.89.0.patch"
    }
  }
}
