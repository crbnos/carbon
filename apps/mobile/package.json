{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --host lan",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "catalogs": "node ./scripts/build-catalogs.mjs",
    "artifacts": "uniwind generate-artifacts --css ./global.css --dts ./src/uniwind-types.d.ts",
    "prestart": "pnpm run catalogs && pnpm run artifacts",
    "prebuild:check": "pnpm run catalogs && pnpm run artifacts",
    "build:check": "expo export --platform ios --platform android --output-dir .expo-export --clear",
    "doctor": "npx -y expo-doctor@latest",
    "typecheck": "pnpm run catalogs && pnpm run artifacts && tsc --noEmit",
    "lint": "biome check --write .",
    "test": "vitest run",
    "clean": "rm -rf .expo .expo-export node_modules src/i18n/generated"
  },
  "dependencies": {
    "@formatjs/intl-locale": "5.3.12",
    "@formatjs/intl-pluralrules": "6.3.15",
    "@gorhom/bottom-sheet": "5.2.14",
    "@internationalized/date": "3.12.0",
    "@lingui/core": "5.9.4",
    "@lingui/react": "5.9.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "2.80.0",
    "@tanstack/react-query": "5.97.0",
    "aes-js": "3.1.2",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "lucide-react-native": "1.48.0",
    "posthog-react-native": "4.78.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-filament": "1.11.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-native-worklets-core": "1.6.3",
    "sonner-native": "0.27.0",
    "tailwindcss": "4.3.3",
    "uniwind": "1.12.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "5.9.4",
    "@types/aes-js": "^3.1.4",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "4.1.6"
  }
}
