{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // expo/tsconfig.base sets no `types`, and React Native's own types are
    // resolved through imports — so this only ADDS node globals, which the
    // vitest files need (they read the web theme and the lingui config off disk).
    "types": ["node"],
    // `@carbon/utils/precision` re-exports the edge-runtime copy by an explicit
    // `.ts` path, which AGENTS.md records as deliberate (the edge runtime only
    // mounts supabase/functions/). Metro resolves it; tsc needs to be told.
    // Safe here because this project only ever typechecks — `expo export` does
    // the bundling, and `noEmit` is set by expo/tsconfig.base.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "~/*": ["./src/*"],
      "~/assets/*": ["./assets/*"],
      "@carbon/mes-core": ["../../packages/mes-core/src/index.ts"],
      "@carbon/mes-core/*": ["../../packages/mes-core/src/*"],
      "@carbon/utils/*": ["../../packages/utils/src/*"],
      "@carbon/viewer/*": ["../../packages/viewer/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/mes-core/src/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".expo",
    ".expo-export",
    // @carbon/mes-core typechecks its own tests under its own tsconfig.
    "../../packages/mes-core/src/**/*.test.ts"
  ]
}
