{
  // The repo is on TypeScript 7 (the native compiler). VS Code's built-in
  // TypeScript support runs its own bundled JavaScript tsserver, an older
  // compiler that also takes several GB of memory on this monorepo; the Native
  // Preview extension runs TypeScript 7's language server instead. After
  // installing it, set "js/ts.experimental.useTsgo": true (or run
  // "TypeScript Native Preview: Enable TypeScript 7 Language Server").
  "recommendations": ["biomejs.biome", "TypeScriptTeam.native-preview"]
}
